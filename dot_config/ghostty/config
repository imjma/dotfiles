font-family = "Berkeley Mono"
font-size = 12
font-thicken = true
font-feature = -calt
font-feature = -liga
font-feature = -dlig

theme = Gruvbox Dark

adjust-cell-height = 20%

mouse-hide-while-typing = true
mouse-scroll-multiplier = 6

window-save-state = always

window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

macos-option-as-alt = left
